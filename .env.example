# Local Docker stack (default)
DATABASE_URL=postgres://prophesy:prophesy@localhost:5432/prophesy?sslmode=disable
REDIS_URL=redis://localhost:6379
PORT=8080
CORS_ORIGIN=http://localhost:3000
ORACLE_SECRET=dev-oracle-secret

# Frontend (browser must reach host-mapped ports)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Oracle (optional — enables GPT-4o research)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ORACLE_ENABLE_WORKER=false
ORACLE_POLL_INTERVAL_SEC=300
SEARCH_MAX_RESULTS=5

# Cloud overrides (Neon + Upstash) — use instead of local postgres/redis
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# REDIS_URL=redis://default:token@host.upstash.io:6379
